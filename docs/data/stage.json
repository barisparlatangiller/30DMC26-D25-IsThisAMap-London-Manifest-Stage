099,21.348,1.8,0.6,"y","on_blok",1],[272,9.099,21.348,1.8,0.6,"y","on_blok",0],[274,9.099,21.348,1.8,0.6,"y","on_blok",0],[276,9.099,21.348,1.8,1.0,"n","on_blok",0],[278,9.099,21.348,1.8,1.0,"n","on_blok",0],[280,9.099,21.348,1.8,1.0,"n","on_blok",1],[282,9.099,21.348,1.8,0.6,"y","on_blok",0],[284,10.099,22.098,1.8,0.6,"y","on_blok",0],[286,10.849,22.098,1.8,0.6,"y","on_blok",0],[288,10.849,22.098,1.8,0.6,"y","on_blok",0],[290,10.849,22.098,1.8,1.0,"n","on_blok",1]],"zones_s":{"platform":30,"merdiven":4,"ana_sahne_on":152,"runway":4,"on_blok":66},"path_m":69.7,"obs":27,"rel":{"lead_pct":8,"front_pct":10,"centre_pct":12,"neighbour":"Mina","neighbour_pct":44,"side":"left","lr":0.39}}],"t0":26,"t1":290,"step":2,"video":"YGtNsXgYqjo","states":{"n":"clear","y":"approximate","s":"silhouette","g":"not visible"},"counts":{"net":478,"yaklasik":122,"gorunmuyor":110,"siluet":88},"kinds":{"ara_deger":636,"gozlem":162},"warp":[[26,27.5],[56,56.5],[72,69.5],[156,151.5],[163,157.5],[168,164.5],[214,213],[220,222.5],[226,228.5],[290,294]],"moments":[{"t":27.5,"title":"Six on the platform","text":"The song opens with all six on the raised platform, 3.3 m above the floor, on average 0.5 m from their centre: the tightest formation of the song.","title_tr":"Platformda altı kişi","text_tr":"Şarkı altı üyeyle, zeminden 3,3 m yüksekteki platformda açılıyor; merkezlerine ortalama 0,5 m uzaklıktalar: şarkının en sıkı dizilimi."},{"t":58.1,"title":"Down the stairs","text":"Lidya and Sueda lead the way down, at 0:58. By 1:01 the platform is empty.","title_tr":"Merdivenden iniş","text_tr":"Lidya ve Sueda 0:58'de ilk inenler. 1:01'de platform boşalıyor."},{"t":63.0,"title":"The main stage","text":"For 2 min 40 s, from 1:03 to 3:42, the main stage is the whole world. The bright band at its front edge is where all six spend most of the song.","title_tr":"Ana sahne","text_tr":"2 dk 40 sn boyunca, 1:03 ile 3:42 arasında, ana sahne bütün dünya. Ön kenarındaki parlak bant altısının şarkının çoğunu geçirdiği yer."},{"t":222.5,"title":"The run","text":"At 3:42 all six cross the 7.5 m runway together, in about 8 seconds.","title_tr":"Koşu","text_tr":"3:42'de altısı birlikte 7,5 m'lik runway'i yaklaşık 8 saniyede geçiyor."},{"t":228.5,"title":"In front of the crowd","text":"From 3:48 all six hold the front block, closest to the audience, until the end (68 s).","title_tr":"Seyircinin önünde","text_tr":"3:48'den sona kadar altısı seyirciye en yakın ön blokta (68 sn)."},{"t":153.2,"title":"Widest formation","text":"At 2:33 the line is at its widest: on average 5.9 m from the centre, 13 times wider than at the opening.","title_tr":"En geniş dizilim","text_tr":"2:33'te sıra en geniş halinde: merkezden ortalama 5,9 m, açılıştakinden 13 kat geniş."},{"t":null,"title":"Walked together","text":"Together the six walk 430 m in one song.","title_tr":"Birlikte yürüdükleri","text_tr":"Altısı tek şarkıda birlikte 430 m yürüyor."},{"t":null,"title":"The line-up","text":"Seen from the audience, left to right, the average order is Esin · Lidya · Zeynep · Mina · Sueda · Hilal; the formations reshuffle it all the time.","title_tr":"Sıralama","text_tr":"Seyirciden bakınca soldan sağa ortalama sıra Esin · Lidya · Zeynep · Mina · Sueda · Hilal; dizilimler bu sırayı sürekli karıştırıyor."},{"t":null,"title":"In front, in turns","text":"On the main stage the one in front changes 14 times, and all six take their turn. Nobody owns the stage; they share it.","title_tr":"Sırayla önde","text_tr":"Ana sahnede öndeki kişi 14 kez değişiyor; altısı da sırayla öne çıkıyor. Sahne kimsenin değil, paylaşılıyor."},{"t":null,"title":"Always side by side","text":"Hilal & Zeynep and Mina & Sueda are each other's nearest neighbour most of the song.","title_tr":"Hep yan yana","text_tr":"Hilal & Zeynep ve Mina & Sueda şarkının çoğunda birbirinin en yakın komşusu."}],"rel_samples":123}